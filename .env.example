# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lets_connect?schema=public"

# Set after running `npm run db:seed` (printed to the console)
DEMO_OWNER_ID=""

# RouterOS / RADIUS cloud endpoints (used by script generator)
# Set to your FreeRADIUS / cloud AAA public IP (appears in generated RouterOS scripts)
# Public IP/hostname of your FreeRADIUS server (required for MikroTik scripts)
NEXT_PUBLIC_CLOUD_RADIUS_IP=""
CLOUD_RADIUS_IP=""
RADIUS_HOST=""
RADIUS_AUTH_PORT="1812"
RADIUS_ACCT_PORT="1813"
RADIUS_SECRET="changeme-lets-connect"
PORTAL_DOMAIN="wifi.letsconnect.co.tz"
# Comma-separated extra payment / CDN hosts for Walled Garden
# PAYMENT_GATEWAY_HOSTS="pay.example.com,cdn.example.com"

# Captive portal + SaaS billing (local gateways)
# Set PAYMENT_DEMO_MODE=true to auto-confirm without live keys
PAYMENT_DEMO_MODE="true"
DEFAULT_PAYMENT_PROVIDER="SNIPPE"
SNIPPE_API_KEY=""
SNIPPE_WEBHOOK_SECRET=""
SELCOM_VENDOR=""
SELCOM_API_KEY=""
SELCOM_API_SECRET=""
CLICKPESA_API_KEY=""
CLICKPESA_SECRET=""
AZAMPAY_APP_NAME=""
AZAMPAY_CLIENT_ID=""
AZAMPAY_CLIENT_SECRET=""
# Public URL used for payment webhooks (no trailing slash)
NEXT_PUBLIC_APP_URL="http://18.199.177.29"
NEXT_PUBLIC_PORTAL_URL="http://18.199.177.29"
# Optional legacy webhook secret for POST /api/webhooks/payment
PAYMENT_WEBHOOK_SECRET=""
# Fallback MikroTik login URL when link-login-only is missing
MIKROTIK_LOGIN_URL="http://10.5.50.1/login"
COOKIE_SECURE="false"

# RouterOS one-command onboarding extras
MIKROTIK_WIREGUARD_ENABLED="false"
WIREGUARD_CLOUD_PUBLIC_KEY=""
WIREGUARD_CLOUD_ENDPOINT=""

# Customer notifications (optional — logs in demo when unset)
RESEND_API_KEY=""
EMAIL_FROM="Lets Connect <noreply@tech-spherewifi.xyz>"
SMS_API_KEY=""
SMS_API_URL=""
SMS_SENDER_ID="LetsConnect"

# FreeRADIUS session supervisor / cron (expiry + PoD disconnect)
RADIUS_SUPERVISOR_INTERVAL_MS="30000"
RADIUS_SUPERVISOR_SECRET=""
CRON_SECRET=""
# MikroTik RADIUS incoming / PoD port (Disconnect-Request)
RADIUS_POD_PORT="3799"
