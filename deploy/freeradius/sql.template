# FreeRADIUS SQL (PostgreSQL) — Lets Connect shared DB
sql {
	driver = "rlm_sql_postgresql"
	dialect = "postgresql"

	server = "${DB_HOST}"
	port = ${DB_PORT}
	login = "${DB_USER}"
	password = "${DB_PASSWORD}"
	radius_db = "${DB_NAME}"

	acct_table1 = "radacct"
	acct_table2 = "radacct"
	postauth_table = "radpostauth"
	authcheck_table = "radcheck"
	authreply_table = "radreply"
	groupcheck_table = "radgroupcheck"
	groupreply_table = "radgroupreply"
	usergroup_table = "radusergroup"

	delete_stale_sessions = yes
	read_groups = yes
	read_profiles = yes

	# Load MikroTik / site clients from `nas` table
	read_clients = yes
	client_table = "nas"
	nas_table = "nas"

	pool {
		start = 2
		min = 2
		max = 10
		spare = 2
		uses = 0
		lifetime = 0
		idle_timeout = 60
	}
}
